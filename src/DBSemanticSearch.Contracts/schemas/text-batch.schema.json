{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/db-semantic-search/text-batch.schema.json",
  "title": "Batch di testi",
  "description": "Formato di caricamento dei testi; ogni elemento non valido viene segnalato senza interrompere gli altri.",
  "type": "object",
  "required": ["texts"],
  "properties": {
    "texts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 10000, "pattern": "\\S" }
    }
  },
  "additionalProperties": true
}
